<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BepInEx 5 mod for Nuclear Option: SELECT targets the unit you are looking at, read from a
    Tobii eye tracker, instead of the one under the HUD's center diamond.

    >>> SET YOUR GAME PATH <<<
    GameDir must point at your Nuclear Option install on the machine that BUILDS this. Create a
    local, gitignored GameDir.props next to this file so your path stays out of source control:

      <Project><PropertyGroup>
        <GameDir>D:\SteamLibrary\steamapps\common\Nuclear Option</GameDir>
      </PropertyGroup></Project>
  -->
  <Import Project="GameDir.props" Condition="Exists('GameDir.props')" />

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>NOTGS</AssemblyName>
    <Product>NOTGS</Product>
    <Description>Nuclear Option Tobii Gaze Select: SELECT targets what you look at</Description>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>NOTGS</RootNamespace>
    <DebugType>portable</DebugType>
    <NoWarn>BepInEx002</NoWarn>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- tools/ holds standalone dev projects with their own csproj — never built into the plugin. -->
    <Compile Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.6" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\NuclearOption_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Aircraft derives from Mirage's NetworkBehaviour; comparing CombatHUD.aircraft needs it. -->
    <Reference Include="Mirage">
      <HintPath>$(GameDir)\NuclearOption_Data\Managed\Mirage.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Rewired owns the joystick/HOTAS; the toggle hotkey reads HOTAS buttons from it directly. -->
    <Reference Include="Rewired_Core">
      <HintPath>$(GameDir)\NuclearOption_Data\Managed\Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- CombatHUD.targetDesignator is a UnityEngine.UI.Image. -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\NuclearOption_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build">
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(GameDir)\BepInEx\plugins"
      OverwriteReadOnlyFiles="true" />
    <Message Text="Deployed $(AssemblyName).dll to $(GameDir)\BepInEx\plugins" Importance="high" />
  </Target>

</Project>
